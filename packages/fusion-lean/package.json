{
  "name": "@local/dsh-fusion-lean",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Fusion MCP facade for DSH: the upstream four tools with their exact schemas, short always-on descriptions, upstream docs on demand, lazy reconnect, a one-shot gate on irreversible actions, and an editable endpoint.",
  "exports": {
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "meta": {
    "title": "Fusion Lean MCP",
    "description": "Fusion 建模的精简接入：schema 原样保留，常驻描述按需加载，Fusion 未启动不再静默。"
  }
}
