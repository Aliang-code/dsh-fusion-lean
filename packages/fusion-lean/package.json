{
  "name": "@aliangbaby/dsh-fusion-lean",
  "version": "0.9.6",
  "private": false,
  "type": "module",
  "description": "Fusion for DSH in one bundle: the upstream MCP tools with their exact schemas and an editable endpoint, plus the fusion-harness CLI bridged as tools.",
  "exports": {
    "./client": "./lib/client.js",
    "./harness": "./src/harness/index.js",
    "./package.json": "./package.json",
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "meta": {
    "title": "Fusion MCP",
    "description": "Fusion 建模的一体化接入：MCP 工具面 + 可编辑端点 + hf 建模闭环，一个包两行。"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliang-code/dsh-fusion-lean.git",
    "directory": "packages/fusion-lean"
  },
  "homepage": "https://github.com/Aliang-code/dsh-fusion-lean",
  "bugs": {
    "url": "https://github.com/Aliang-code/dsh-fusion-lean/issues"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "fusion",
    "fusion360",
    "mcp",
    "cad",
    "parametric"
  ]
}
